 	copy() {
 		const copy = new Renderer(this.global, this.#parent);
+		// the constructor derives `type` from the parent, which is wrong for `head`
+		// renderers — without this, `subsume` writes the parent's type back onto the
+		// original and `<svelte:head>` markers get emitted into the body
+		copy.type = this.type;
 		copy.#out = this.#out.map((item) => (item instanceof Renderer ? item.copy() : item));
 		copy.promise = this.promise;
 		return copy;
