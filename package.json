{
	"name": "noph-ui",
	"version": "0.40.1",
	"license": "MIT",
	"homepage": "https://noph.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cnolte/noph-ui.git"
	},
	"author": {
		"name": "cnolte"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"keywords": [
		"svelte",
		"svelte 5",
		"material",
		"material 3",
		"expressive",
		"material you",
		"material expressive",
		"m3",
		"ui",
		"frontend",
		"design-system",
		"ui-library",
		"theming"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"docs:toc": "node scripts/build-toc.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./defaultTheme": {
			"types": "./dist/themes/defaultTheme.css.d.ts",
			"import": "./dist/themes/defaultTheme.css",
			"require": "./dist/themes/defaultTheme.css"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@materialx/material-color-utilities": "^0.4.8",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "7.0.0-next.6",
		"@sveltejs/kit": "3.0.0-next.23",
		"@sveltejs/package": "3.0.0-next.7",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "^24",
		"@types/prismjs": "^1.26.6",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prismjs": "^1.30.0",
		"publint": "^0.3.23",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"valibot": "^1.4.2",
		"vite": "8.2.1",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.1.1"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"packageManager": "pnpm@11.9.0"
}
